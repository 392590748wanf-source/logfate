{
  "name": "gilfate",
  "productName": "GilFate",
  "version": "1.1.13",
  "packageManager": "pnpm@11.19.0",
  "description": "FF14 装备与潜水艇成本、库存及销售利润账本",
  "author": "392590748wanf-source",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check fantasy.js && node --check electron/main.cjs && node --check electron/preload.cjs && pnpm data:check",
    "data:build": "node tools/build-data-bundle.mjs",
    "data:check": "node tools/build-data-bundle.mjs --check",
    "leves:verify": "node tools/sync-levequest-verification.mjs",
    "leves:recipes": "node tools/sync-levequest-recipes.mjs",
    "leves:sources": "node tools/sync-levequest-material-sources.mjs",
    "leves:icons": "node tools/sync-levequest-icons.mjs",
    "icons:sync": "node tools/sync-garland-icons.mjs",
    "icon:build": "powershell.exe -ExecutionPolicy Bypass -File tools/generate-app-icon.ps1",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "release": "pnpm run dist:win"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.ff14.fantasy.ledger",
    "productName": "GilFate",
    "artifactName": "GilFate-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release{,/**}",
      "!tools{,/**}",
      "!*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GilFate",
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "392590748wanf-source",
        "repo": "logfate",
        "releaseType": "release"
      }
    ]
  }
}
